# Copy to .env and fill in. Never commit the real file.

# OpenAI. This is the only value local development needs.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# OIDC provider. Leave these commented out to use the Keycloak from docker-compose.yml.
# To use another provider instead, set all three and register the redirect URI
# http://localhost:5173/login/oauth2/code/oidc with it.
# OIDC_ISSUER_URI=https://your-tenant.example.com
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# The audience the MCP server expects in the access tokens of that provider.
# MCP_TOKEN_AUDIENCE=mcp-kb-server
